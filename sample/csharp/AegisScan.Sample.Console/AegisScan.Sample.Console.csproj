<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>AegisScan.Sample.Console</RootNamespace>
    <!-- Allows running on newer installed runtimes than the pinned TFM. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../bindings/dotnet/AegisScan.Interop/AegisScan.Interop.csproj" />
  </ItemGroup>

  <!-- Copy the native core next to the sample so it runs out of the box. -->
  <ItemGroup>
    <None Include="../../../core/build/libaegis_core.dylib" Condition="Exists('../../../core/build/libaegis_core.dylib')"
          CopyToOutputDirectory="PreserveNewest" Link="libaegis_core.dylib" />
    <None Include="../../../core/build/libaegis_core.so" Condition="Exists('../../../core/build/libaegis_core.so')"
          CopyToOutputDirectory="PreserveNewest" Link="libaegis_core.so" />
    <None Include="../../../core/build/aegis_core.dll" Condition="Exists('../../../core/build/aegis_core.dll')"
          CopyToOutputDirectory="PreserveNewest" Link="aegis_core.dll" />
  </ItemGroup>

</Project>
